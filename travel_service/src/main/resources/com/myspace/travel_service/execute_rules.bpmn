    <bpmn2:scriptTask id="_356A7BF6-1AD1-5A75-A6A1-6553D4566EBA" name="Set Rules Decision" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Set Rules Decision]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[false]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_31DD6AE7-26A2-5AC3-B369-4D6A22B16BAA</bpmn2:incoming>
      <bpmn2:outgoing>_5B88BF56-6B93-5667-BD3F-7D9B54ABB2F8</bpmn2:outgoing>
      <bpmn2:script><![CDATA[String resp = (String) kcontext.getVariable("rulesResponse");
if (resp == null) { resp = ""; }
String compact = resp.replace(" ", "");

//Outcome returned by Reels: STP or NonSTP
String decision = compact.contains("\"outcome\":\"STP\"") ? "STP" : "NonSTP";
kcontext.setVariable("stp_decision", decision);

//Optional remarks returned by Reels
String remarks = "";
java.util.regex.Matcher m = java.util.regex.Pattern.compile("\"decision_remarks\"\\s*:\\s*\"([^\"]*)\"").matcher(resp);
if (m.find()) { remarks = m.group(1); }
kcontext.setVariable("decision_remarks", remarks);
System.out.println("cid:" + kcontext.getVariable("cid") + ", stp_decision:" + decision);]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:callActivity id="_B1B592D2-018C-5FA7-99BB-5AFB3F29E13F" drools:independent="false" drools:waitForCompletion="true" name="Add Audit - Rules Executed" calledElement="travel_service.send_audit">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Add Audit - Rules Executed]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[kcontext.setVariable("title","Rules Executed");
kcontext.setVariable("description","Reels outcome: " + kcontext.getVariable("stp_decision"));]]></drools:script>
        </drools:onEntry-script>
        <drools:metaData name="customAbortParent">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[false]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
