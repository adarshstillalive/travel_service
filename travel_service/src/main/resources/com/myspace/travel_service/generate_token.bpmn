    <bpmn2:scriptTask id="_0FA084A7-928F-5F01-8AB7-CED1B1C0F3BA" name="Extract Token" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Extract Token]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[false]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_29CBFEE1-F884-5D9E-AA20-607C625FC0D8</bpmn2:incoming>
      <bpmn2:outgoing>_13CBE53F-8EF2-572C-9E98-702AE5145517</bpmn2:outgoing>
      <bpmn2:script><![CDATA[String resp = (String) kcontext.getVariable("tokenResponse");
String accessToken = "";
java.util.regex.Matcher m = java.util.regex.Pattern.compile("\"access_token\"\\s*:\\s*\"([^\"]*)\"").matcher(resp == null ? "" : resp);
if (m.find()) { accessToken = m.group(1); }
kcontext.setVariable("token", "Authorization=Bearer " + accessToken);]]></bpmn2:script>
    </bpmn2:scriptTask>
