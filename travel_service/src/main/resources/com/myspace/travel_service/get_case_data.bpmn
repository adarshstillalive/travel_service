    <bpmn2:scriptTask id="_6CA4683E-5860-5ACE-A849-1FAD2C3D2F04" name="INIT" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[INIT]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[false]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_40ACF8DD-6007-5433-BA44-7CA9074E05F6</bpmn2:incoming>
      <bpmn2:outgoing>_EA2355C6-082E-5DBD-85D7-8D2C776D8BB5</bpmn2:outgoing>
      <bpmn2:script><![CDATA[System.out.println("cid:"+kcontext.getVariable("cid")+",node:"+kcontext.getNodeInstance().getNodeName()+",process:"+kcontext.getProcessInstance().getProcessName());
System.setProperty("jbpm.loop.level.disabled","true");

//Set Base Path
String baseUrl = "https://sandbox.neutrinos-apps.com";

//Set API Method and Content Type
kcontext.setVariable("method","POST");
kcontext.setVariable("contentType","application/json");
kcontext.setVariable("isHandleResponseErrors","true");

//Set API Url
kcontext.setVariable("url", baseUrl + "/caseservice/case/instance/get");

//Payload
String payload = "{" + "\"cid\":\"" + String.valueOf(kcontext.getVariable("cid")) + "\"" + "}";
kcontext.setVariable("payload", payload);
kcontext.setVariable("channel","service");]]></bpmn2:script>
    </bpmn2:scriptTask>
