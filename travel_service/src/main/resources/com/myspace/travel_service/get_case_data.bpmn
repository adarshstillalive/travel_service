      <bpmn2:incoming>_34448AFB-23DF-5487-A0AC-3A7512166F8A</bpmn2:incoming>
      <bpmn2:outgoing>_897EEA16-DC77-5510-B1D2-ADAFEBB29EEB</bpmn2:outgoing>
      <bpmn2:script><![CDATA[String data = (String) kcontext.getVariable("caseData");
if (data == null) { data = ""; }
String[] keys = {"serviceRequestId", "original_destination", "change_destination"};
for (String key : keys) {
    java.util.regex.Matcher m = java.util.regex.Pattern.compile("\"" + key + "\"\\s*:\\s*\"([^\"]*)\"").matcher(data);
    if (m.find()) { kcontext.setVariable(key, m.group(1)); }
}]]></bpmn2:script>
    </bpmn2:scriptTask>
